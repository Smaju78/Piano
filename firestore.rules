rules_version = '2';

// Piano: each signed-in person can read, write and delete only their own document, users/{their uid}.
// Nothing else in the database is readable or writable from the site.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prefs', 'prefsAt', 'session', 'updated']);
    }
  }
}
